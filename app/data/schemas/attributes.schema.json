{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Attribute definitions",
  "type": "object",
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "key",
        "label",
        "type",
        "filterable",
        "searchable",
        "isVariantAxis",
        "showOnProductPage",
        "sortOrder"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^attr_[a-z0-9_]+$"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$",
          "description": "camelCase key used in product.attributes and variant.options"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "number",
            "boolean",
            "select",
            "multiselect"
          ]
        },
        "unit": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "hex": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "filterable": {
          "type": "boolean"
        },
        "searchable": {
          "type": "boolean"
        },
        "isVariantAxis": {
          "type": "boolean"
        },
        "showOnProductPage": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  }
}
